(() => {
  const header = document.querySelector('.header');
  const panel = header && header.querySelector('.nav-mobile');
  if (!header || !panel) return;

  // Шукаємо вже існуючу кнопку в HTML або створюємо її, якщо її немає
  let burger = header.querySelector('.burger');
  
  panel.id = panel.id || 'mobile-menu';

  if (!burger) {
    const inner = header.querySelector('.header__inner');
    if (!inner) return;
    burger = document.createElement('button');
    burger.type = 'button';
    burger.className = 'burger';
    burger.innerHTML = '<span class="burger__icon" aria-hidden="true"></span>';
    inner.append(burger);
  }

  burger.setAttribute('aria-label', 'Відкрити меню');
  burger.setAttribute('aria-expanded', 'false');
  burger.setAttribute('aria-controls', panel.id);
  header.classList.add('header--js');

  const setOpen = (open) => {
    panel.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
  };

  // Перемикання при кліку на бургер
  burger.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!panel.classList.contains('is-open'));
  });

  // Закриваємо меню після вибору будь-якого пункту
  panel.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Натискання Esc закриває меню й повертає фокус на кнопку
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) {
      setOpen(false);
      burger.focus();
    }
  });

  // Клік поза межами шапки закриває меню
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target)) setOpen(false);
  });

  // При переході на десктопний розмір (>= 1024px) автоматично закриваємо мобільне меню
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
})();